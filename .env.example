# Local Postgres from docker-compose.yml. On Vercel this is the Neon connection string.
DATABASE_URL=postgres://books:books@localhost:5433/books

# Auth.js — generate with: pnpm dlx auth secret
AUTH_SECRET=
# GitHub OAuth app (callback: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Only this email can edit the catalogue
OWNER_EMAIL=eftakharsazid@gmail.com
# Local only: shows a "Dev sign-in" button that signs you in as OWNER_EMAIL without GitHub
AUTH_DEV_LOGIN=true

# Vercel Blob — optional; without it covers are linked from the source
BLOB_READ_WRITE_TOKEN=
# Optional, raises Google Books rate limits
GOOGLE_BOOKS_API_KEY=
# Pass 2: photo identification
ANTHROPIC_API_KEY=
